{
    "name": "mwl91/tdd",
    "description": "TDD Kurs",
    "type": "project",
    "require-dev": {
        "phpunit/phpunit": "^11.3",
        "pestphp/pest": "^3.7",
        "symfony/var-dumper": "^7.2"
    },
    "autoload": {
        "psr-4": {
            "Mwl91\\Tdd\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mwl91\\Tests\\Tdd\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Marcin Lenkowski",
            "email": "marcin@lenkowski.net"
        }
    ],
    "require": {
        "moneyphp/money": "^4.5",
        "ramsey/uuid": "^4.7",
        "fakerphp/faker": "^1.23"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
